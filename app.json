{
  "expo": {
    "name": "Quip",
    "slug": "quip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/quip-icon.png",
    "scheme": "quip",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/quip-icon.png",
      "bundleIdentifier": "com.evank.quip"
    },
    "android": {
      "package": "com.evank.quip",
      "adaptiveIcon": {
        "backgroundColor": "#347553",
        "foregroundImage": "./assets/brand/quip-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/quip-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/brand/quip-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/quip-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFCFB",
          "image": "./assets/brand/quip-splash.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Quip to record your practice responses.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FAFCFB"
  }
}
